{
  "name": "king-live-panel",
  "version": "1.0.2",
  "private": true,
  "description": "王者荣耀直播信息屏 · 左心率 / 中央歌词 / 右五分路",
  "author": "King Live Panel",
  "license": "UNLICENSED",
  "engines": { "node": ">=22.12.0" },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && npm run icons && vite build && node scripts/build-electron.mjs",
    "icons": "node scripts/build-icons.cjs",
    "start": "electron .",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.cjs",
    "test:portable": "node scripts/test-portable.cjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "playwright": "^1.58.0",
    "typescript": "^5.9.0",
    "vite": "6.4.3",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "local.kinglive.panel",
    "productName": "King Live Panel",
    "artifactName": "KingLivePanel-${version}-portable.zip",
    "directories": { "output": "release" },
    "files": ["dist/index.html", "dist/app-icon.svg", "dist/app-icon.png", "dist-electron/main.cjs", "dist-electron/preload.cjs", "package.json", "!node_modules{,/**/*}"],
    "extraFiles": [{ "from": "portable-readme.txt", "to": "使用说明.txt" }],
    "asar": true,
    "win": { "target": "zip", "icon": "public/app-icon.ico", "signExecutable": false }
  }
}
